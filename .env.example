RAPTOR_SOURCE_PATH='<source-folder-or-SMB-share>'
RAPTOR_SMB_USERNAME='<SMB-username-if-needed>'
RAPTOR_SMB_PASSWORD='<SMB-password-if-needed>'
RAPTOR_SMB_DOMAIN='<optional-SMB-domain>'
RAPTOR_ARCHIVE_DIR='<existing-writable-archive-folder>'
RAPTOR_DB_PATH='<database-file-in-existing-folder>'
RAPTOR_TIMEZONE='<IANA-timezone>'
RAPTOR_LOG_LEVEL='<DEBUG-INFO-WARNING-or-ERROR>'

# Linux delivery is enabled by setting PUSH_PULL=push.
# PUSH_PULL=push
# RAPTOR_PUSH_DEST=user@host:/srv/data/bronze/
